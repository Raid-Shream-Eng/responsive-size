{
    "compilerOptions": {
        "target": "es2019",
        "module": "esnext",
        "moduleResolution": "bundler",
        
        "rootDir": "src",
        "outDir": "dist",

        "declaration": true,
        "declarationMap": true,
        
        "strict": true,
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true,
    },
    "include": ["src"]
}
